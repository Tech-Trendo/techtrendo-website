# Backend API origin (no trailing slash). The Next.js app appends /api/app.
NEXT_PUBLIC_API_URL=https://app.techtrendo.com

# Google reCAPTCHA v2 site key. Must match the secret key on the backend.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LfeReYrAAAAAL-1oIYBYCBs1wQ7I_x_-Rc7At8O

# Shared secret for the on-demand revalidation webhook (/api/revalidate).
# Must match NEXT_REVALIDATE_SECRET in the backend .env.
REVALIDATE_SECRET=change_me_to_a_long_random_string